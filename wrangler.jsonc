// Cloudflare hosting: the web build (static files) plus a small Worker for live sessions.
{
  "name": "inkwell",
  "main": "worker/index.ts",
  "compatibility_date": "2026-10-19",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    // Everything except live sessions and the download links is served straight from the static files.
    "run_worker_first": ["/api/*", "/download", "/download/*"]
  },
  // Workers AI (free daily allowance): reads handwriting for "Convert to text" when the user opts in.
  "ai": { "binding": "AI" },
  "durable_objects": {
    "bindings": [{ "name": "LIVE", "class_name": "LiveSession" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["LiveSession"] }]
}
